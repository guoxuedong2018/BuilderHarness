{
  "key": "EXPERIMENTS",
  "title": "Save a draft experiment",
  "status": "confirmed",
  "goal": "Create a synthetic draft experiment and find it after reloading the list.",
  "scope": {
    "include": [
      "Save, list and reload a draft"
    ],
    "exclude": [
      "Remote services"
    ]
  },
  "prototype": {
    "entryRoute": "/experiments"
  },
  "spec": [
    {
      "group": "Experiments",
      "route": "/experiments",
      "shots": [
        "experiments"
      ],
      "points": [
        {
          "id": "FP1",
          "name": "Draft creation",
          "origin": "new",
          "display": [
            "Created drafts are visible in the list."
          ],
          "interaction": [
            "A valid name creates a local draft. An empty name leaves the dialog open for correction."
          ],
          "ac": [
            "AC1",
            "AC2"
          ]
        }
      ]
    }
  ],
  "acceptance": [
    "AC1: A created draft is visible in the list after a reload.",
    "AC2: Empty name displays an error and allows correction."
  ],
  "verification": [
    {
      "id": "save-and-reload",
      "ac": [
        "AC1"
      ],
      "required": true,
      "route": "/experiments",
      "steps": [
        {
          "click": "text=New experiment"
        },
        {
          "expect": "#experiment-name"
        },
        {
          "fill": {
            "selector": "#experiment-name",
            "text": "Synthetic saved draft"
          }
        },
        {
          "click": "text=Create experiment"
        },
        {
          "expect": "text=Synthetic saved draft"
        },
        {
          "reload": true
        },
        {
          "expect": "text=Synthetic saved draft"
        }
      ]
    },
    {
      "id": "empty-name-recovery",
      "ac": [
        "AC2"
      ],
      "required": true,
      "route": "/experiments",
      "steps": [
        {
          "click": "text=New experiment"
        },
        {
          "expect": "#experiment-name"
        },
        {
          "click": "text=Create experiment"
        },
        {
          "expect": "text=Give the experiment a name so the team can find it later."
        },
        {
          "fill": {
            "selector": "#experiment-name",
            "text": "Synthetic recovered draft"
          }
        },
        {
          "click": "text=Create experiment"
        },
        {
          "expect": "text=Synthetic recovered draft"
        }
      ]
    }
  ],
  "shots": {
    "experiments": {
      "route": "/experiments",
      "caption": "Experiment list with synthetic data"
    }
  },
  "openQuestions": [],
  "background": {
    "problem": [
      "The draft disappears when the workspace reloads."
    ],
    "solution": [
      "Persist the synthetic draft and show it in the experiment list."
    ]
  }
}

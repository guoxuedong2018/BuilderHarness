{
  "name": "@builderharness/desktop",
  "private": true,
  "version": "0.4.6",
  "description": "Thin BuilderHarness desktop shell around an upstream DeepSeek Harness profile.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "install-profile": "node install-profile.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:mas": "electron-builder --mas"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "license": "MIT",
  "productName": "BuilderHarness",
  "build": {
    "appId": "com.builderharness.desktop",
    "productName": "BuilderHarness",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "starter-project.mjs",
      "preload.cjs",
      "onboarding.html",
      "onboarding.css",
      "onboarding.js",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "../../",
        "to": "builderharness",
        "filter": [
          "bin/**/*",
          "pipeline/**/*",
          "scaffold/**/*",
          "docs/templates/**/*",
          "package.json",
          "integrations/host/src/**/*",
          "packages/browser/**/*",
          "build/**/*",
          "client/**/*",
          "server/**/*",
          "ui-spec/**/*",
          "vite.mjs"
        ]
      },
      {
        "from": "../../integrations/host",
        "to": "builderharness/host",
        "filter": [
          "**/*",
          "!**/node_modules/**/*"
        ]
      }
    ]
  }
}

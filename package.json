{
  "name": "builderharness",
  "version": "0.9.0",
  "description": "BuilderHarness — an agent harness for Product Builders: spec-gated, same-stack prototype as source of truth, review before ship, with production pieces connected through adapters.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agent-harness",
    "spec-driven",
    "product-builder",
    "prototype",
    "review",
    "comments",
    "vite",
    "vue",
    "react",
    "product-management",
    "documentation",
    "content",
    "publishing",
    "agent",
    "deepseek-harness",
    "dsh",
    "mcp",
    "screenshots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoxuedong2018/BuilderHarness.git"
  },
  "homepage": "https://github.com/guoxuedong2018/BuilderHarness#readme",
  "bugs": {
    "url": "https://github.com/guoxuedong2018/BuilderHarness/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./client/index.js",
    "./vite": "./vite.mjs",
    "./core": "./client/core/mount.jsx",
    "./vue2": "./client/adapters/vue2.js",
    "./react": "./client/adapters/react.jsx",
    "./ui": "./ui-spec/impl/react/index.ts",
    "./tokens.css": "./ui-spec/tokens.css",
    "./tailwind.config.js": "./ui-spec/impl/react/tailwind.config.cjs",
    "./package.json": "./package.json",
    "./tailwind.config.cjs": "./ui-spec/impl/react/tailwind.config.cjs",
    "./context": "./integrations/host/src/task-context.mjs",
    "./mcp": "./integrations/host/src/mcp.mjs"
  },
  "bin": {
    "builderharness": "./bin/builderharness.mjs",
    "builderharness-mcp": "./integrations/host/src/mcp.mjs"
  },
  "files": [
    "bin",
    "build",
    "client",
    "docs",
    "examples/react-tailwind/README.md",
    "examples/react-tailwind/index.html",
    "examples/react-tailwind/package.json",
    "examples/react-tailwind/postcss.config.cjs",
    "examples/react-tailwind/src",
    "examples/react-tailwind/tailwind.config.cjs",
    "examples/react-tailwind/vite.config.js",
    "examples/react-tailwind/docs/features",
    "examples/react-tailwind/docs/kb",
    "pipeline",
    "integrations/README.md",
    "integrations/host",
    "integrations/desktop/README.md",
    "integrations/desktop/package.json",
    "integrations/desktop/main.cjs",
    "integrations/desktop/starter-project.mjs",
    "integrations/desktop/preload.cjs",
    "integrations/desktop/onboarding.html",
    "integrations/desktop/onboarding.css",
    "integrations/desktop/onboarding.js",
    "integrations/desktop/install-profile.mjs",
    "integrations/desktop/assets",
    "integrations/desktop/build",
    "scaffold",
    "server",
    "ui-spec",
    "vite.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "packages/browser/package.json",
    "packages/browser/README.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs && node bin/builderharness.mjs check-frs && node scripts/check-ui-spec.mjs && node scripts/check-public-deps.mjs && node integrations/test-integrations.mjs && node scripts/test-scaffold.mjs && node --test scripts/test-agent-workflow.mjs",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "test:deploy-skill": "node scripts/test-deploy-skill-e2e.mjs",
    "test:publish-gateway": "node scripts/test-publish-gateway.mjs",
    "test:integrations": "node integrations/test-integrations.mjs",
    "demo": "node scripts/demo.mjs",
    "build:demo": "node scripts/demo.mjs build",
    "preflight": "node scripts/preflight-dist.mjs",
    "prepublishOnly": "npm run check",
    "check:frs": "node bin/builderharness.mjs check-frs",
    "test:workflow": "node --test scripts/test-agent-workflow.mjs",
    "test:packages": "node scripts/test-packages.mjs",
    "test:agents": "node scripts/test-agent-hosts.mjs"
  },
  "peerDependencies": {
    "less": ">=3",
    "tailwindcss": ">=4",
    "vite": ">=5",
    "vue": "^2.7.0",
    "@builderharness/browser": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "less": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@builderharness/browser": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "less": "^4.9.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "valtio": "^2.3.2"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
